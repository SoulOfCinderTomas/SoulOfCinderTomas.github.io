---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="mb-24">
  <h1 class="mb-8 text-3xl font-bold tracking-tight text-white">{title}</h1>
  <div class="panel-card">
    <p class="body-copy">{description}</p>
  </div>
</section>
