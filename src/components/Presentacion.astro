---
import { site } from '@data/site';

const { hero, video } = site;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

function getYouTubeEmbed(url: string): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    if (u.pathname.includes('/embed/')) return url;
    if (u.hostname.includes('youtu.be')) {
      const id = u.pathname.slice(1);
      return id ? `https://www.youtube.com/embed/${id}` : null;
    }
    const id = u.searchParams.get('v');
    return id ? `https://www.youtube.com/embed/${id}` : null;
  } catch {
    return null;
  }
}

const embedUrl = video.type === 'youtube' ? getYouTubeEmbed(video.src) : null;
const fileSrc = video.type === 'file' && video.src ? `${base}${video.src.replace(/^\//, '')}` : null;
const linkSrc = video.type === 'link' && video.src ? video.src : null;
---

<section id="presentacion" class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8" aria-labelledby="presentacion-heading">
  <h2 id="presentacion-heading" class="section-heading">Presentación</h2>

  <div class="reveal-content space-y-10">
    <div class="flex flex-col items-center gap-5 sm:flex-row sm:items-start">
      <div class="h-24 w-24 shrink-0 overflow-hidden rounded-full border-2 border-accent shadow-[0_0_40px_color-mix(in_srgb,var(--color-accent)_28%,transparent)]">
        <img
          src={hero.avatarSrc}
          alt={hero.avatarAlt}
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
          width="96"
          height="96"
        />
      </div>
      <div class="space-y-2 text-center sm:text-left">
        <h1 class="text-3xl font-bold tracking-tight text-white">{hero.name}</h1>
        <p class="text-lg font-medium text-slate-light">{hero.role}</p>
        <p class="body-copy max-w-prose">{hero.tagline}</p>
      </div>
    </div>

    <div class="panel-card">
      <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-accent">{video.title}</h3>

      {embedUrl ? (
        <div class="aspect-video w-full overflow-hidden rounded-lg">
          <iframe
            class="h-full w-full"
            src={embedUrl}
            title={video.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      ) : fileSrc ? (
        <video class="w-full rounded-lg" controls src={fileSrc}>
          Tu navegador no soporta la reproducción de video.
        </video>
      ) : linkSrc ? (
        <a href={linkSrc} target="_blank" rel="noreferrer" class="subtle-link">
          Ver video de presentación →
        </a>
      ) : (
        <p class="body-copy text-slate-lightest">
          Aún no hay un video cargado. Edita <code>data/site.ts</code> (campo <code>video</code>) para agregar el tuyo.
        </p>
      )}
    </div>
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
